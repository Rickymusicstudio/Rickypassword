# Copy to .env.local (never committed) and fill in from Supabase → Project Settings → API.
# The same two VITE_ values go into Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only for the one-time import (tools/import-content.mjs). Keep it secret:
# never put it in Vercel, never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
