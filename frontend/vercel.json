{
  "rewrites": [
    { "source": "/n/:slug", "destination": "/og/news/:slug.html" },

    {
      "source": "/news/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(WhatsApp|facebookexternalhit|TwitterBot|Slackbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|redditbot|crawler|bot).*"
        }
      ],
      "destination": "/og/news/:slug.html"
    },

    { "source": "/api/:path*", "destination": "https://rickypassword.onrender.com/api/:path*" },

    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
