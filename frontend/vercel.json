{
  "routes": [
    { "src": "^/n/([^/]+)$", "dest": "/api/s/$1" },

    {
      "src": "^/news/([^/]+)$",
      "has": [
        { "type": "header", "key": "user-agent", "value": "(?i).*(WhatsApp|facebookexternalhit|TwitterBot|Slackbot|TelegramBot|LinkedInBot|Discordbot|Pinterest|redditbot).*" }
      ],
      "dest": "/api/s/$1"
    },

    { "src": "^/api/local-ok$", "dest": "/api/local-ok" },
    { "src": "^/api/s/([^/]+)$", "dest": "/api/s/$1" },

   
    { "handle": "filesystem" },
    { "src": "^/news\\.json$", "dest": "/news.json" },

   
    { "src": "^/api/(.*)$", "dest": "https://rickypassword.onrender.com/api/$1" },

    
    { "src": "^(?!/api/).*", "dest": "/" }
  ]
}
